# This file will automatically update with entries for new content after a build and reload.

# ==================== Common ====================
Common: {
	KeybindNotSet: <KeybindNotSet>
	MovementAcc:
		'''
		 class accessory
		[c/888888:Hold <shift> for more info]
		'''
	DasherAcc:
		'''
		[c/999999:<ability> to dash ({0} stamina)]
		[c/999999:<altAbility> to long dash ({1} stamina)]
		[c/999999:{2} {^2:second;seconds} of dash time]
		[c/999999:Dash speed: {3}]
		[c/999999:{4} {^4:second;seconds} of invincibility]
		'''
	ChargerAcc:
		'''
		[c/999999:<ability> to charge ({0} stamina per second)]
		[c/999999:<altAbility> to slam ({1} stamina per second)]
		[c/999999:Max speed: {2}]
		[c/999999:Charge acceleration: {3}]
		[c/999999:Turn acceleration: {4}]
		[c/999999:{5}% damage reduction at max speed]
		[c/999999:{6} impact damage at max speed]
		'''
	SpiritAcc:
		'''
		[c/999999:<ability> to enter spirit form ({0} stamina per second)]
		[c/999999:<altAbility> to fling]
		[c/999999:Distance decay rate: {1}]
		[c/999999:Damage absorption: {2}%]
		[c/999999:{3}% increased speed in spirit form]
		[c/999999:Fling speed: {4}]
		'''
	GrapplerAcc:
		'''
		[c/999999:<ability> to grapple ({0} stamina per second)]
		[c/999999:<altAbility> to pull/reel ({1} stamina per second)]
		[c/999999:Range: {2}]
		[c/999999:Pull speed on enemies: {3}]
		[c/999999:Reel speed on player: {4}]
		'''
}

# ==================== Items ====================
Items: {
	WoodenShield: {
		DisplayName: Wooden Shield
		Tooltip:
			'''
			A primitive shield that grants the wearer a short dash
			{$MovementClass.Dasher}{$Common.MovementAcc}
			{$Common.DasherAcc}
			'''
	}

	WoodenGauntlets: {
		DisplayName: Wooden Gauntlets
		Tooltip:
			'''
			Allows for a short charge and slam
			{$MovementClass.Charger}{$Common.MovementAcc}
			{$Common.ChargerAcc}
			'''
	}

	SlimeAtomizer: {
		DisplayName: Slime Atomizer
		Tooltip:
			'''
			"Gone, reduced to slime"
			{$MovementClass.Spirit}{$Common.MovementAcc}
			{$Common.SpiritAcc}
			[c/999999:100% increased jump height in spirit form]
			'''
	}

	WoodenGrapple: {
		DisplayName: Wooden Grapple
		Tooltip:
			'''
			"It don't mean a thing if it ain't got that swing!"
			{$MovementClass.Grappler}{$Common.MovementAcc}
			{$Common.GrapplerAcc}
			'''
	}
}

# ==================== Keybinds ====================
Keybinds: {
	Parry.DisplayName: Parry
	MovementAbility.DisplayName: Movement Ability
	MovementAltAility.DisplayName: Movement Alt Ability
}

# ==================== Buffs ====================
Buffs: {
	LungedBuff: {
		DisplayName: Lunged Buff
		Description: Doubles your melee damage for 1 second after dashing
	}
}

# ==================== Configs ====================
Configs: {
	NullandVoidClientConfig: {
		DisplayName: Client Config

		Headers: {
			Parrying: Parrying
			StyleMeter: Style Meter
			Movement: Movement
			Blood: Blood
			Misc: Miscellaneous
		}

		ParryFlashIntensity: {
			Label: Flash intensity
			Tooltip: Intensity of the flash after parrying. (0 to disable)
		}

		ParryShakeIntensity: {
			Label: Camera shake intensity
			Tooltip: Intensity of the camera shake after parrying. (0 to disable)
		}

		ParrySoundVolume: {
			Label: Sound effects volume
			Tooltip: Volume of the sound effects after parrying. (0 to disable)
		}

		MaxStyleBonuses: {
			Label: Max style bonuses
			Tooltip: Maximum amount of style bonuses that can be displayed at once (0 to disable)
		}

		StyleBonusFadeTime: {
			Label: Style bonus fade time
			Tooltip: Time in seconds for style bonuses to show before fading
		}

		StyleMeterHideTime: {
			Label: Hide UI after seconds inactive
			Tooltip: Inactive time in seconds needed for the style meter to be hidden (0 to disable)
		}

		StyleMeterEase: {
			Label: Style bonus easing
			Tooltip: Toggle for style bonuses to ease in & out
		}

		ShowParryUI: {
			Label: Show parry UI
			Tooltip: ""
		}

		ShowStaminaUI: {
			Label: Show stamina UI
			Tooltip: ""
		}

		StaminaSoundVolume: {
			Label: Stamina sound volume
			Tooltip: Volume of the stamina refilling sound effect
		}

		ShowStyleMeterUI: {
			Label: Show style meter UI
			Tooltip: ""
		}

		ShowBloodSpill: {
			Label: Show Blood Spill
			Tooltip: Custom blood effects when damaging enemies
		}

		BloodAmount: {
			Label: Blood Amount
			Tooltip: ""
		}

		ShowBloodTrail: {
			Label: Show Blood Trail
			Tooltip: Blood particles have trails
		}

		BloodSize: {
			Label: Blood Size
			Tooltip: ""
		}

		CameraShakeIntensity: {
			Label: Camera shake intensity
			Tooltip: Intensity of the camera shake for miscellaneous visual effects. (0 to disable)
		}

		PogoVolume: {
			Label: Pogo volume
			Tooltip: ""
		}

		DashAbilitiesVolume: {
			Label: Dash abilities volume
			Tooltip: ""
		}

		ChargeAbilitiesVolume: {
			Label: Charge abilities volume
			Tooltip: ""
		}

		SpiritAbilitiesVolume: {
			Label: Spirit abilities volume
			Tooltip: ""
		}

		GrappleAbilitiesVolume: {
			Label: Grapple abilities volume
			Tooltip: ""
		}

		GeneralDustAmount: {
			Label: General dust amount
			Tooltip: The amount of dust that renders for miscellaneous visual effects (0 to disable)
		}
	}

	NullandVoidServerConfig.DisplayName: Server Config
}

