# This file will automatically update with entries for new content after a build and reload.

# ==================== Common ====================
Common: {
	MovementAcc: "[c/888888:Hold <{0}> for more info]"
	DasherAcc:
		'''
		{$MovementClass.Dasher} class accessory
		{$Common.MovementAcc}
		[c/999999:Uses {1} stamina]   
		[c/999999:{2} {^2:second;seconds} of dash time]
		[c/999999:{3} dash speed]
		[c/999999:{4} {^4:second;seconds} of invincibility]
		'''
	ChargerAcc:
		'''
		{$MovementClass.Charger} class accessory
		{$Common.MovementAcc}
		[c/999999:Uses {1} stamina per second]
		[c/999999:{2} max speed]
		[c/999999:{3} charge acceleration]
		[c/999999:{4} turn acceleration]
		[c/999999:{5}% damage reduction at max speed]
		[c/999999:{6} impact damage at max speed]
		'''
	SpiritAcc:
		'''
		{$MovementClass.Spirit} class accessory
		{$Common.MovementAcc}
		[c/999999:Uses {1} stamina per second]
		[c/999999:{2} distance decay rate]
		[c/999999:{3} damage cost]
		[c/999999:{4} spirit speed]
		[c/999999:{5} fling speed]
		'''
	GrapplerAcc:
		'''
		{$MovementClass.Spirit} class accessory
		{$Common.MovementAcc}
		[c/999999:Uses {1} stamina per second]
		[c/999999:{2} range]
		[c/999999:{3} pull speed on enemies]
		[c/999999:{4} reel speed on player]
		'''
}

# ==================== Items ====================
Items: {
	TestSword: {
		DisplayName: Test Sword
		Tooltip:
			'''
			Template of an item
			Replacing this tooltip is duty 
			It's snowing on Mt.Fuji
			'''
	}

	WoodenShield: {
		DisplayName: Wooden Shield
		Tooltip:
			'''
			A primitive shield that grants the wearer a short dash
			{$Common.DasherAcc}
			'''
	}

	WoodenGauntlets: {
		DisplayName: Wooden Gauntlets
		Tooltip:
			'''
			Allows for a short charge
			{$Common.ChargerAcc}
			'''
	}
}

